#!/bin/bash
# vm - boot WinCraft OS in QEMU (QEMU itself lives in the build toolbox).
#
#   tools/vm                      boot the ISO in a window
#   tools/vm --headless           no window; drive it with tools/qmp.py
#   tools/vm --uefi               UEFI firmware instead of BIOS
#   tools/vm --disk FILE[:SIZE]   attach a virtual hard disk (created if missing)
#   tools/vm --no-iso             boot from the disk only
#   tools/vm --iso FILE           boot another ISO than out/wincraft-<version>-x86_64.iso
#   tools/vm --direct "ARGS"      skip the boot loader: load kernel + initramfs
#                                 directly with this kernel command line
#   tools/vm --shell              root shells on the serial port and Ctrl+Alt+F2
#                                 (for tools/qmp.py sh), booting through the
#                                 boot menu as usual, unlike --direct
#   tools/vm --gamepads           hand the game controllers connected now to
#                                 the VM (the host stops seeing them)
#   tools/vm --no-gl              plain VGA adapter, no 3D acceleration
#   tools/vm --mem MB --smp N --res WxH --share DIR
#
# Hardware virtualisation (KVM) is used when /dev/kvm is available; otherwise
# QEMU falls back to software emulation, which works but is many times slower.
# In a window, the graphics adapter is a virtio GPU with 3D acceleration
# (virgl): the guest's OpenGL, and Direct3D through Wine, are drawn by the
# host's GPU. That needs a render node (/dev/dri/renderD*) and QEMU's GL
# modules in the toolbox; without them, or with --no-gl or --headless, the
# adapter is plain VGA and the guest renders in software.
set -euo pipefail

PROJECT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION=$(cat "$PROJECT/VERSION")
ISO=/work/out/wincraft-$VERSION-x86_64.iso
VM=/work/build/vm

headless=0 uefi=0 disk= direct= mem=4096 smp=4 res=1280x800 use_iso=1 share= nogl=0 shell=0 gamepads=0
while [ $# -gt 0 ]; do
    case "$1" in
        --headless) headless=1 ;;
        --uefi)     uefi=1 ;;
        --no-iso)   use_iso=0 ;;
        --iso)      case "$2" in
                        /work/*)       ISO=$2 ;;
                        "$PROJECT"/*)  ISO=/work/${2#"$PROJECT"/} ;;   # QEMU runs in the toolbox
                        /*)            echo "vm: the ISO must be inside $PROJECT" >&2; exit 2 ;;
                        *)             ISO=/work/$2 ;;
                    esac; shift ;;
        --disk)     disk=$2; shift ;;
        --direct)   direct=$2; shift ;;
        --mem)      mem=$2; shift ;;
        --smp)      smp=$2; shift ;;
        --res)      res=$2; shift ;;
        --share)    share=$2; shift ;;
        --no-gl)    nogl=1 ;;
        --shell)    shell=1 ;;
        --gamepads) gamepads=1 ;;
        -h|--help)  sed -n '2,27p' "$0"; exit 0 ;;
        *) echo "vm: unknown option $1" >&2; exit 2 ;;
    esac
    shift
done

mkdir -p "$PROJECT/build/vm"
rm -f "$PROJECT/build/vm/qmp.sock" "$PROJECT/build/vm/serial.sock" "$PROJECT/build/vm/out.sock"

args=(-name "WinCraft OS" -machine q35 -m "$mem" -smp "$smp")
if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    args+=(-accel kvm -cpu host)
else
    echo "vm: /dev/kvm not available - using software emulation (slow)" >&2
    args+=(-accel tcg,thread=multi,tb-size=1024 -cpu max)
fi

gl=0
if [ "$headless" = 0 ] && [ "$nogl" = 0 ] && compgen -G "/dev/dri/renderD*" >/dev/null &&
   [ -f "$PROJECT/build/toolbox/usr/lib/qemu/hw-display-virtio-vga-gl.so" ]; then
    gl=1
    args+=(-device "virtio-vga-gl,xres=${res%x*},yres=${res#*x}")
else
    args+=(-device "VGA,xres=${res%x*},yres=${res#*x}")
fi
args+=(-device qemu-xhci -device usb-tablet -device usb-kbd
       -nic user,model=virtio-net-pci
       -rtc base=utc
       -qmp "unix:$VM/qmp.sock,server=on,wait=off"
       -chardev "socket,id=ser0,path=$VM/serial.sock,server=on,wait=off,logfile=$VM/serial.log"
       -serial chardev:ser0
       # the clipboard, shared with the guest's wcclip (text only)
       -device virtio-serial-pci
       -chardev qemu-vdagent,id=vdagent,clipboard=on,mouse=off
       -device virtserialport,chardev=vdagent,name=com.redhat.spice.0)

if [ "$uefi" = 1 ]; then
    [ -f "$PROJECT/build/vm/OVMF_VARS.fd" ] ||
        "$PROJECT/tools/tb" cp /usr/share/edk2/x64/OVMF_VARS.4m.fd "$VM/OVMF_VARS.fd"
    args+=(-drive "if=pflash,format=raw,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd"
           -drive "if=pflash,format=raw,file=$VM/OVMF_VARS.fd")
fi

[ "$use_iso" = 1 ] && args+=(-drive "file=$ISO,media=cdrom,readonly=on,if=none,id=cd0"
                             -device ide-cd,drive=cd0,bootindex=2)

if [ -n "$disk" ]; then
    size=20G
    case "$disk" in *:*) size=${disk##*:}; disk=${disk%%:*} ;; esac
    case "$disk" in /*) ;; *) disk=/work/$disk ;; esac
    host_disk=${disk/#\/work/$PROJECT}
    [ -f "$host_disk" ] || "$PROJECT/tools/tb" qemu-img create -q -f qcow2 "$disk" "$size"
    args+=(-drive "file=$disk,format=qcow2,if=none,id=hd0" -device virtio-blk-pci,drive=hd0,bootindex=1)
fi

# read by the guest's rc.boot (images newer than 0.6.1); out.sock is a fast
# channel to the guest for tools/qmp.py, where the serial port would stall it
[ "$shell" = 1 ] && args+=(-smbios "type=11,value=wincraft.shell"
    -chardev "socket,id=wcout,path=$VM/out.sock,server=on,wait=off"
    -device "virtserialport,chardev=wcout,name=org.wincraft.out")

# Game controllers: their input devices, forwarded as virtio input devices
# with the same name and USB ids, so that Wine recognises them (an Xbox
# controller becomes an XInput gamepad). This needs read-write access to
# /dev/input/eventN, which the desktop grants the logged-in user for
# joysticks; the USB device itself is usually root's only.
if [ "$gamepads" = 1 ]; then
    found=0
    for pad in /dev/input/by-id/*-event-joystick; do
        [ -e "$pad" ] || continue
        dev=$(readlink -f "$pad")
        if [ -r "$dev" ] && [ -w "$dev" ]; then
            args+=(-device "virtio-input-host-pci,evdev=$dev")
            echo "vm: game controller ${pad##*/} -> VM" >&2
            found=1
        else
            echo "vm: no access to $dev (${pad##*/}), not passed" >&2
        fi
    done
    [ "$found" = 1 ] || echo "vm: --gamepads: no game controller found" >&2
fi

if [ -n "$share" ]; then
    args+=(-virtfs "local,path=$share,mount_tag=host,security_model=none,readonly=on")
fi

if [ -n "$direct" ]; then
    args+=(-kernel /work/build/iso/boot/vmlinuz -initrd /work/build/iso/boot/initramfs.img
           -append "$direct")
fi

if [ "$headless" = 1 ]; then
    args+=(-display none -audiodev none,id=snd0)
    gui=0
else
    # Sound goes to the host's PulseAudio-compatible socket when there is one
    # (WC_AUDIO=none to force silence).
    runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    if [ "${WC_AUDIO:-}" != none ] && [ -S "$runtime/pulse/native" ]; then
        args+=(-audiodev pa,id=snd0,server=unix:/run/host/pulse/native)
    else
        args+=(-audiodev none,id=snd0)
    fi
    args+=(-display "gtk,gl=$([ $gl = 1 ] && echo on || echo off),zoom-to-fit=on,clipboard=on")
    gui=1
fi
args+=(-device intel-hda -device hda-output,audiodev=snd0)

exec env TB_GUI=$gui "$PROJECT/tools/tb" qemu-system-x86_64 "${args[@]}"
