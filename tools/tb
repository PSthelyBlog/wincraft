#!/bin/bash
# tb - run a command inside the rootless WinCraft build toolbox.
#
# The toolbox is an Arch Linux root in build/toolbox, entered through user
# namespaces (no sudo, nothing installed on the host). Inside, we are "root"
# with a full uid range mapped from /etc/subuid, so pacman, chroot, mknod-free
# rootfs assembly and mksquashfs all behave as they would for real root.
#
#   tools/tb <command...>      run command (cwd = /work = project root)
#   tools/tb                   interactive shell
#
# Env: TB_GUI=1 binds the host Wayland/X sockets (used to show the QEMU window).
#
# The QEMU window draws the VM's 3D (virgl) with the host's GPU, through the
# toolbox's Mesa. Mesa cannot use a GPU run by NVIDIA's own driver and falls
# back to drawing on the CPU (llvmpipe); so when the screen is on such a GPU,
# TB_GUI=1 also binds in the host's NVIDIA EGL libraries, which match its
# kernel module, and the Wayland and GBM platforms they need. A laptop whose
# screen is on its other GPU (AMD or Intel), beside an NVIDIA one, keeps
# Mesa, which draws there; NVIDIA's EGL cannot, and QEMU would stop as soon
# as the guest's 3D starts. TB_HOSTGL=1 binds them whenever NVIDIA's driver
# is loaded, TB_HOSTGL=0 never.
set -euo pipefail

PROJECT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TB="$PROJECT/build/toolbox"
[ -d "$TB/usr" ] || { echo "tb: toolbox not found at $TB (run ./wc toolbox)" >&2; exit 1; }

export TB PROJECT
# Is a screen connected to a card that another driver than NVIDIA's runs?
other_screen() {
    local c card
    for c in /sys/class/drm/card*-*; do
        [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
        card=${c##*/} card=${card%%-*}       # card2-eDP-1 -> card2
        [ "$(basename "$(readlink -f "/sys/class/drm/$card/device/driver")")" = nvidia ] || return 0
    done
    return 1
}

export TB_GUI="${TB_GUI:-0}"
if [ -z "${TB_HOSTGL:-}" ]; then
    if other_screen; then TB_HOSTGL=0; else TB_HOSTGL=1; fi
fi
export TB_HOSTGL
export TB_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export TB_WAYLAND="${WAYLAND_DISPLAY:-}"
export TB_DISPLAY="${DISPLAY:-}"
export TB_TERM="${TERM:-xterm}"

[ $# -eq 0 ] && set -- /bin/bash

exec unshare --user --map-root-user --map-auto --mount --pid --fork --kill-child \
  /bin/bash -c '
set -e
mount --make-rprivate /
mount --rbind "$TB" "$TB"
mount -t proc proc "$TB/proc"
mount --rbind /sys "$TB/sys"
mount --rbind /dev "$TB/dev"
mount -t tmpfs -o mode=1777 tmpfs "$TB/tmp"
mount -t tmpfs -o mode=755 tmpfs "$TB/run"
mkdir -p "$TB/work"
mount --rbind "$PROJECT" "$TB/work"
cat /etc/resolv.conf > "$TB/etc/resolv.conf" 2>/dev/null || true
genv=()
if [ "$TB_GUI" = 1 ]; then
  mkdir -p "$TB/run/host"
  mount --rbind "$TB_RUNTIME" "$TB/run/host"
  genv+=(XDG_RUNTIME_DIR=/run/host)
  [ -n "$TB_WAYLAND" ] && genv+=(WAYLAND_DISPLAY="$TB_WAYLAND")
  if [ -n "$TB_DISPLAY" ] && [ -d /tmp/.X11-unix ]; then
    mkdir -p "$TB/tmp/.X11-unix"
    mount --rbind /tmp/.X11-unix "$TB/tmp/.X11-unix"
    genv+=(DISPLAY="$TB_DISPLAY")
  fi
  # NVIDIA: the host'"'"'s own EGL driver, in /run/hostgl (see above)
  lib=
  for l in /usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu; do
    [ -e "$l/libEGL_nvidia.so.0" ] && { lib=$l; break; }
  done
  if [ "$TB_HOSTGL" = 1 ] && [ -e /proc/driver/nvidia/version ] && [ -n "$lib" ]; then
    d="$TB/run/hostgl"
    mkdir -p "$d/egl_external_platform.d" "$d/gbm"
    for f in "$lib"/libEGL_nvidia.so* "$lib"/libnvidia-*.so*; do
      [ -e "$f" ] || continue
      : > "$d/${f##*/}"
      mount --bind "$f" "$d/${f##*/}"
    done
    if [ -e "$lib/gbm/nvidia-drm_gbm.so" ]; then
      : > "$d/gbm/nvidia-drm_gbm.so"
      mount --bind "$lib/gbm/nvidia-drm_gbm.so" "$d/gbm/nvidia-drm_gbm.so"
    fi
    cp /usr/share/egl/egl_external_platform.d/*nvidia*.json "$d/egl_external_platform.d/" 2>/dev/null || true
    echo "{\"file_format_version\": \"1.0.0\", \"ICD\": {\"library_path\": \"libEGL_nvidia.so.0\"}}" > "$d/nvidia.json"
    genv+=(LD_LIBRARY_PATH=/run/hostgl __EGL_VENDOR_LIBRARY_FILENAMES=/run/hostgl/nvidia.json
           __EGL_EXTERNAL_PLATFORM_CONFIG_DIRS=/run/hostgl/egl_external_platform.d
           GBM_BACKENDS_PATH=/run/hostgl/gbm)
  fi
fi
cd "$TB"
exec chroot "$TB" /usr/bin/env -i \
  HOME=/root USER=root LOGNAME=root TERM="$TB_TERM" LANG=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/bin/core_perl \
  MAKEFLAGS="-j$(nproc)" "${genv[@]}" \
  /bin/bash -c "cd /work && exec \"\$@\"" tb "$@"
' tb-enter "$@"
