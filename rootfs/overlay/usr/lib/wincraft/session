#!/bin/sh
# WinCraft graphical session (runs as root, supervised by wcinit):
# start the display server, then hand the screen to the user's Windows desktop.
# When either side exits, tear the other down; wcinit starts a fresh session.
export PATH=/usr/bin
export DISPLAY=:0

# With ntsync, Wine's server holds one file descriptor per synchronisation
# object, and a web browser needs more than the kernel's default hard limit of
# 4096. Raise the hard limit only: Wine lifts its own soft limit to match.
ulimit -Hn 524288

rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
# Only the socket file /tmp/.X11-unix/X0, no abstract socket ("local"): the
# WinCraft Agent's sandbox shares the network namespace, where abstract
# sockets live, but not /tmp, so it cannot reach this display. With -ac any
# program that reaches it may read the screen and send it input.
/usr/lib/Xorg :0 vt1 -nolisten tcp -nolisten local -ac -noreset -logfile /run/log/Xorg.0.log &
xpid=$!

n=0
until [ -S /tmp/.X11-unix/X0 ] && xrandr >/dev/null 2>&1; do
    kill -0 "$xpid" 2>/dev/null || { echo "session: display server exited"; exit 1; }
    n=$((n + 1))
    [ "$n" -gt 300 ] && { echo "session: display server did not come up"; kill "$xpid"; exit 1; }
    sleep 0.2
done

[ -s /run/wincraft/kbd ] && setxkbmap "$(cat /run/wincraft/kbd)"

/usr/bin/setpriv --reuid=1000 --regid=1000 --init-groups /usr/lib/wincraft/desktop

kill "$xpid" 2>/dev/null
wait
